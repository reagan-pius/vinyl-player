{
  "name": "vinyl-player",
  "private": true,
  "version": "0.0.0",
  "description": "Web turntable music player — local audio through a real-time vinyl AudioWorklet DSP chain.",
  "license": "MIT",
  "author": "reagan-pius <reaganpius05@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reagan-pius/vinyl-player.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "npm run test:dsp && npm run test:store && npm run test:metadata && npm run test:smoke",
    "test:dsp": "node scripts/test-dsp.mjs",
    "test:dsp:probe": "node scripts/probe-dsp.mjs",
    "test:store": "node scripts/test-store.mjs",
    "test:metadata": "node scripts/test-metadata.mjs",
    "test:smoke": "npm run build && node scripts/smoke-browser.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
